# Campus Mode — environment variables
# Copy to .env.local and fill in from your Supabase project:
#   Supabase Dashboard → Project Settings → API

# Project URL (e.g. https://xxxx.supabase.co) — safe to expose
NEXT_PUBLIC_SUPABASE_URL=

# anon/public key — safe to expose (client auth in Phase 2)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role key — SECRET, server-only. Never expose to the browser.
# Used by /api/orders to save orders + upload design images.
SUPABASE_SERVICE_ROLE_KEY=
